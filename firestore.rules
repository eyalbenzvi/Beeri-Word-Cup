rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/gameData/users).data.data[request.auth.uid].isAdmin == true;
    }
    function isLocked() {
      return get(/databases/$(database)/documents/gameData/settings).data.data.predictionsLocked == true;
    }

    // gameData collection — single documents
    match /gameData/{docId} {
      allow read: if isAuth();

      // Users document: first creation allowed; updates restricted
      allow create: if isAuth() && docId == 'users';
      allow update: if isAuth() && docId == 'users' && (
        isAdmin() || (
          // Regular user: only their own key changed in the users map
          request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly([request.auth.uid]) &&
          (
            // New user entry: isAdmin must be false
            (!(request.auth.uid in resource.data.data) &&
             request.resource.data.data[request.auth.uid].isAdmin == false) ||
            // Existing user entry: isAdmin must stay the same
            (request.auth.uid in resource.data.data &&
             request.resource.data.data[request.auth.uid].isAdmin == resource.data.data[request.auth.uid].isAdmin)
          )
        )
      );

      // Admin-only documents
      allow write: if isAdmin() && docId in ['matchResults', 'settings', 'actualBonuses', 'actualAdvancing'];
    }

    // predictions collection — one document per form
    // TODO (H25): When Cloud Functions are added, validate tournament start timestamp
    // to prevent form creation/submission after the tournament has started.
    // This requires a stored tournament start date in settings.
    match /predictions/{formId} {
      // Before lock: users can only read their own forms. After lock or admin: read all.
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isLocked() || isAdmin()
      );

      // Users can create their own forms only when predictions not locked
      // H29: new forms must have correct userId and start as draft
      allow create: if isAuth() && formId.matches(request.auth.uid + '__.*') && !isLocked()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'draft';

      // Users can update their own forms only when not locked; admins always
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid && !isLocked()) || isAdmin()
      );

      // Users can delete their own forms only when not locked; admins can delete any
      allow delete: if isAuth() && (
        (resource.data.userId == request.auth.uid && !isLocked()) || isAdmin()
      );
    }

    // Audit log — append-only for authenticated users, read for admins
    // Validates: userId must match auth, action and timestamp required
    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.timestamp is string;
    }
  }
}
