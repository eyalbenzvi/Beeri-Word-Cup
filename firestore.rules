rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }
    function isAdmin() {
      // Prefer Custom Claims (set server-side, tamper-proof); fall back to Firestore users doc
      return isAuth() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/gameData/users).data.data[request.auth.uid].isAdmin == true
      );
    }
    function isLocked() {
      return get(/databases/$(database)/documents/gameData/settings).data.data.predictionsLocked == true;
    }

    // --- predictions schema allow-lists (H14/H1/H18) ---
    // Fields a non-admin user is allowed to set when creating a form.
    function userCreateFields() {
      return [
        'userId', 'formName', 'budgetNumber',
        'matches', 'advancing', 'champion', 'topScorer',
        'status', 'createdAt'
      ];
    }
    // Fields a non-admin user is allowed to mutate when updating a form.
    // Admin-only fields (approvedAt, adminSubmittedAt, adminReopenedAt,
    // adminEditedAt, adminNote) are intentionally excluded.
    function userUpdateFields() {
      return [
        'formName', 'budgetNumber',
        'matches', 'advancing', 'champion', 'topScorer',
        'status', 'updatedAt', 'submittedAt', 'reopenedAt'
      ];
    }
    // Allowed FSM transitions of `status` for a non-admin user.
    // `submitted -> draft` is permitted so that users can reopen an admin-
    // approved form for editing before tournament lock. `allow update` still
    // gates the whole transition on !isLocked().
    function validUserStatusTransition(oldStatus, newStatus) {
      return (oldStatus == 'draft' && (newStatus == 'draft' || newStatus == 'pending')) ||
             (oldStatus == 'pending' && newStatus == 'draft') ||
             (oldStatus == 'submitted' && newStatus == 'draft');
    }

    // gameData collection — single documents
    match /gameData/{docId} {
      // Most docs require auth; the `settings` doc is public so the
      // welcome screen can show lock state before the user logs in.
      allow read: if isAuth() || docId == 'settings';

      // Users document: first creation allowed; updates restricted
      allow create: if isAuth() && docId == 'users';
      allow update: if isAuth() && docId == 'users' && (
        isAdmin() || (
          // Regular user: only their own key changed in the users map
          request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly([request.auth.uid]) &&
          (
            // New user entry: isAdmin must be false
            (!(request.auth.uid in resource.data.data) &&
             request.resource.data.data[request.auth.uid].isAdmin == false) ||
            // Existing user entry: isAdmin must stay the same
            (request.auth.uid in resource.data.data &&
             request.resource.data.data[request.auth.uid].isAdmin == resource.data.data[request.auth.uid].isAdmin)
          )
        )
      );

      // Admin-only documents
      allow write: if isAdmin() && docId in ['matchResults', 'settings', 'actualBonuses', 'actualAdvancing'];
    }

    // predictions collection — one document per form
    // TODO (H25): When Cloud Functions are added, validate tournament start timestamp
    // to prevent form creation/submission after the tournament has started.
    // This requires a stored tournament start date in settings.
    match /predictions/{formId} {
      // Before lock: users can only read their own forms. After lock or admin: read all.
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isLocked() || isAdmin()
      );

      // Users can create their own forms only when predictions not locked.
      // H29: new forms must have correct userId and start as draft.
      // H14: only the whitelisted fields may be present on create.
      // Admins may create any form (needed for full-database restore from backup).
      allow create: if isAuth() && (
        isAdmin() || (
          formId.matches(request.auth.uid + '__.*') && !isLocked()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'draft'
          && request.resource.data.keys().hasOnly(userCreateFields())
        )
      );

      // Updates:
      //   - Admin: may change anything except userId (immutable).
      //   - Owner (not locked): status must follow the allowed FSM, and the
      //     set of changed keys must be a subset of userUpdateFields.
      allow update: if isAuth() && request.resource.data.userId == resource.data.userId && (
        isAdmin() || (
          resource.data.userId == request.auth.uid && !isLocked()
          && validUserStatusTransition(resource.data.status, request.resource.data.status)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userUpdateFields())
        )
      );

      // Users can delete their own forms only when not locked; admins can delete any
      allow delete: if isAuth() && (
        (resource.data.userId == request.auth.uid && !isLocked()) || isAdmin()
      );
    }

    // summaries collection — one document per blog post
    // Read: published summaries are public (shareable via link, no auth
    //       required for the doc); listing requires status filter on client.
    // Write: admin only, with shape validation.
    function summaryAllowedFields() {
      return [
        'number', 'title', 'subtitle', 'intro', 'conclusion',
        'coveredMatchIds', 'matchNotes', 'status',
        'authorUid', 'createdAt', 'updatedAt', 'publishedAt'
      ];
    }
    function validSummaryStatus(s) {
      return s == 'draft' || s == 'published';
    }
    // Full shape + size validation. Enforces string types on every free-text
    // field so a malformed/abusive admin write can't bloat documents beyond
    // Firestore's 1 MB limit or expose large-payload DoS to readers.
    function validSummaryShape(d) {
      return d.keys().hasOnly(summaryAllowedFields())
        && d.title is string && d.title.size() <= 300
        && (!('subtitle' in d) || (d.subtitle is string && d.subtitle.size() <= 500))
        && (!('intro' in d) || (d.intro is string && d.intro.size() <= 20000))
        && (!('conclusion' in d) || (d.conclusion is string && d.conclusion.size() <= 20000))
        && d.status is string && validSummaryStatus(d.status)
        && d.number is number
        && d.coveredMatchIds is list && d.coveredMatchIds.size() <= 40
        && d.matchNotes is map && d.matchNotes.size() <= 40
        && (!('authorUid' in d) || d.authorUid is string)
        && (!('createdAt' in d) || d.createdAt is string)
        && (!('updatedAt' in d) || d.updatedAt is string)
        && (!('publishedAt' in d) || d.publishedAt is string);
    }
    match /summaries/{summaryId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() && validSummaryShape(request.resource.data);
      // `number`, `authorUid`, `createdAt` are immutable post-creation.
      allow update: if isAdmin() && validSummaryShape(request.resource.data)
        && request.resource.data.number == resource.data.number
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // Audit log — append-only for authenticated users, read for admins
    // Validates: userId must match auth, action and timestamp required
    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.timestamp is string;
    }

    // Server-side counters written by Netlify Functions via Admin SDK.
    // Admin SDK bypasses security rules; listing explicit denies here
    // documents that clients must never read or write these collections.
    match /rateLimit/{id} {
      allow read, write: if false;
    }
    match /otpVerifyAttempts/{id} {
      allow read, write: if false;
    }
  }
}
